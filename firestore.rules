rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security enforcement
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true ||
         request.auth.token.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    function isApprovedTeacher() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    function isExamOwner(examId) {
      return isAuthenticated() &&
        isApprovedTeacher() &&
        exists(/databases/$(database)/documents/exams/$(examId)) &&
        get(/databases/$(database)/documents/exams/$(examId)).data.teacherId == request.auth.uid;
    }

    // User profiles collection
    match /users/{userId} {
      // Users can read their own profile; admins can read all profiles
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // New user registration creates teacher profile as 'pending'
      allow create: if isAuthenticated() && 
        request.auth.uid == userId && 
        request.resource.data.role == 'teacher' && 
        request.resource.data.status == 'pending';

      // Updates restricted: users cannot modify role or status; only admins can change role/status
      allow update: if isAdmin() || (
        isAuthenticated() && 
        request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'admin'])
      );
      
      allow delete: if isAdmin();
    }

    // Exam documents - public read restricted to published exams; drafts restricted to owning approved teacher or admins
    match /exams/{examId} {
      allow read: if (!('status' in resource.data) || resource.data.status == 'published') || (
        isAuthenticated() && (
          (resource.data.teacherId == request.auth.uid && isApprovedTeacher()) || isAdmin()
        )
      );
      allow create: if isAuthenticated() && (isApprovedTeacher() || isAdmin());
      allow update, delete: if isAuthenticated() && (
        (resource.data.teacherId == request.auth.uid && isApprovedTeacher()) || isAdmin()
      );
    }

    // Exam Attempts - public create for students; read and delete restricted to exam owner (approved teacher) or admin
    match /attempts/{attemptId} {
      allow create: if request.resource.data.examId is string && request.resource.data.studentName is string;
      allow read: if isAuthenticated() && (isExamOwner(resource.data.examId) || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAuthenticated() && (isExamOwner(resource.data.examId) || isAdmin());
    }

    // Admin Activity Audit Logs - restricted to admins
    match /adminActivity/{activityId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // AI Usage Logs - server Admin SDK writes directly; client access restricted to admins only
    match /aiUsage/{usageId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
