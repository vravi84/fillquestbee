rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security enforcement
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true ||
         request.auth.token.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    function isApprovedTeacher() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    // User profiles collection
    match /users/{userId} {
      // Users can read their own profile; admins can read all profiles
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // New user registration creates teacher profile as 'pending'
      allow create: if isAuthenticated() && 
        request.auth.uid == userId && 
        request.resource.data.role == 'teacher' && 
        request.resource.data.status == 'pending';

      // Updates restricted: users cannot modify role or status; only admins can change role/status
      allow update: if isAdmin() || (
        isAuthenticated() && 
        request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'admin'])
      );
      
      allow delete: if isAdmin();
    }

    // Exam documents - public read for student test taking; write restricted to approved teachers or admins
    match /exams/{examId} {
      allow read: if true;
      allow create: if isAuthenticated() && (isApprovedTeacher() || isAdmin());
      allow update, delete: if isAuthenticated() && (
        (resource.data.teacherId == request.auth.uid && isApprovedTeacher()) || isAdmin()
      );
    }

    // Exam Attempts - public create for students; read restricted to teacher owner or admin
    match /attempts/{attemptId} {
      allow create: if true;
      allow read: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Admin Activity Audit Logs - restricted to admins
    match /adminActivity/{activityId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // AI Usage Logs - read restricted to admins
    match /aiUsage/{usageId} {
      allow read: if isAdmin();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }
  }
}
